# Replace the placeholders with real GitHub usernames.
# GitHub requests a review from the owner automatically when a PR touches their files.

# --- Backend ---
# Bell — API, database, contract
/backend/src/api/        @BELL_USERNAME
/backend/prisma/         @BELL_USERNAME
/contracts/              @BELL_USERNAME

# Relay — queue and realtime
/backend/src/queue/      @RELAY_USERNAME
/backend/src/workers/    @RELAY_USERNAME
/backend/src/realtime/   @RELAY_USERNAME

# Ember — outside providers
/backend/src/channels/   @EMBER_USERNAME
/backend/src/templates/  @EMBER_USERNAME

# --- Frontend ---
# Prism — shell and shared UI. Reviews anything shared.
/frontend/src/app/          @PRISM_USERNAME
/frontend/src/components/   @PRISM_USERNAME
/frontend/tailwind.config.* @PRISM_USERNAME

# Pulse — notification surface
/frontend/src/features/notifications/   @PULSE_USERNAME @PRISM_USERNAME

# Beacon — preferences surface
/frontend/src/features/preferences/     @BEACON_USERNAME @PRISM_USERNAME

# --- Infrastructure ---
# Warden — CI, deploys, tests
/.github/           @WARDEN_USERNAME
/docker-compose.yml @WARDEN_USERNAME
/backend/tests/     @WARDEN_USERNAME
/frontend/tests/    @WARDEN_USERNAME
