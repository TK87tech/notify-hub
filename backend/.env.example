# Copy this file to backend/.env and fill it in.
#
#   Copy-Item .env.example .env          (PowerShell)
#   cp .env.example .env                 (Mac, Linux, Git Bash)
#
# Prisma reads .env from the folder you run it in, so this must live in
# backend/, not the project root. .env is gitignored - never commit it.

# --- Database -----------------------------------------------------------
# Local Docker (run `docker compose up -d` from the project root first):
DATABASE_URL=postgresql://notifyhub:notifyhub@localhost:5432/notifyhub

# Or a free Neon database, if you would rather not run Docker.
# Neon needs sslmode=require on the end:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/notifyhub?sslmode=require

# --- Redis for BullMQ ---------------------------------------------------
REDIS_URL=redis://localhost:6379
# Or a free Upstash database:
# REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Extra browser origins, comma separated, used by both CORS and the Socket.IO
# handshake. Leave empty locally. In production the Vercel URL goes here,
# because the frontend and the API are on different domains:
# CORS_ORIGINS=https://notify-hub.vercel.app

# --- Auth ---------------------------------------------------------------
# At least 16 characters. Generate a real one - see backend/README.md.
#
# The two values below are working on purpose so a fresh clone runs without
# generating anything. Do NOT deploy them: both are published in this
# repository, and src/config/env.ts refuses to boot in production while either
# is still set to the example value. That check is the actual protection - this
# comment is just the reason for it.
JWT_SECRET=dev-only-6c925f080b9865c7f7cc7056555ed86a
# At least 8 characters.
SERVICE_KEY=dev-only-99ccd10ef8fd6991355be151

# --- Email: Brevo free tier, 300/day ------------------------------------
BREVO_API_KEY=
EMAIL_FROM="NotifyHub <no-reply@example.com>"

# The email ceiling, and the short-window limiter in front of it.
#
# These two do different jobs. EMAIL_RATE_MAX is how fast we may call Brevo -
# a token bucket, so a burst gets smoothed rather than rejected. EMAIL_DAILY_LIMIT
# is the hard daily ceiling; a job that would exceed it is parked until the UTC
# day rolls over instead of burning one of its five attempts.
#
# Brevo's free tier allows 300/day. Leave EMAIL_DAILY_LIMIT at or below that or
# the account gets throttled by Brevo instead of by us. See docs/RUNBOOK.md.
EMAIL_DAILY_LIMIT=300
EMAIL_RATE_MAX=20
EMAIL_RATE_WINDOW_MS=60000

# --- Push: Firebase Cloud Messaging -------------------------------------
# All three or none. With any one missing the push channel reports a permanent
# failure into the dead-letter queue rather than silently skipping, so a typo
# here is visible instead of looking like "this user has no phone".
#
# FCM_PRIVATE_KEY is the whole private key with its newlines escaped as \n -
# one line, because a real newline cannot survive a .env value:
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Monitoring ---------------------------------------------------------
# Optional. Empty disables Sentry entirely. Only failures are reported; the
# sign-in limiter and delivery logs stay local.
SENTRY_DSN=

# Render free tier only: the worker's public health URL, e.g.
# https://notifyhub-worker.onrender.com/health. A free web service sleeps after
# 15 minutes without HTTP traffic, and a sleeping worker delivers nothing, so
# the API requests this URL whenever it queues a job. Leave empty locally.
WORKER_WAKE_URL=
# One of: silent, fatal, error, warn, info, debug, trace. Health-check traffic
# is never logged whatever this is set to.
LOG_LEVEL=info
