# Copy this file to backend/.env and fill it in.
#
#   Copy-Item .env.example .env          (PowerShell)
#   cp .env.example .env                 (Mac, Linux, Git Bash)
#
# Prisma reads .env from the folder you run it in, so this must live in
# backend/, not the project root. .env is gitignored - never commit it.

# --- Database -----------------------------------------------------------
# Local Docker (run `docker compose up -d` from the project root first):
DATABASE_URL=postgresql://notifyhub:notifyhub@localhost:5432/notifyhub

# Or a free Neon database, if you would rather not run Docker.
# Neon needs sslmode=require on the end:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/notifyhub?sslmode=require

# --- Redis for BullMQ ---------------------------------------------------
REDIS_URL=redis://localhost:6379
# Or a free Upstash database:
# REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# --- Auth ---------------------------------------------------------------
# At least 16 characters. Generate a real one - see backend/README.md.
JWT_SECRET=dev-only-6c925f080b9865c7f7cc7056555ed86a
# At least 8 characters.
SERVICE_KEY=dev-only-99ccd10ef8fd6991355be151

# --- Email: Brevo free tier, 300/day ------------------------------------
BREVO_API_KEY=
EMAIL_FROM="NotifyHub <no-reply@example.com>"

# --- Push: Firebase Cloud Messaging -------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
