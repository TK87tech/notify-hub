# Copy this file to frontend/.env and fill it in.
#
#   Copy-Item .env.example .env          (PowerShell)
#   cp .env.example .env                 (Mac, Linux, Git Bash)
#
# This file must live in frontend/, not the project root. Vite loads .env from
# the folder you run it in. .env is gitignored - never commit it.
#
# Only variables prefixed VITE_ reach the browser, and everything that does is
# public. Never put a secret behind one of these: a Firebase *private* key or
# the service key would be readable by anyone who loads the page.

# --- API ----------------------------------------------------------------
# Must include the /api/v1 prefix - the contract's servers[0].url does, and the
# generated client appends bare paths like /notifications to it. This is the
# single most common reason the app builds fine and then 404s on every call.
VITE_API_URL=http://localhost:4000/api/v1

# --- Realtime -----------------------------------------------------------
# Where the Socket.IO gateway lives. Optional: left empty it defaults to
# VITE_API_URL with the /api/v1 prefix stripped, which is the right answer
# everywhere so far because the gateway attaches to the API's HTTP server.
#
# Only set this if that ever stops being true - a dedicated realtime host, say.
# Getting it wrong fails quietly: the app still loads and every list still
# refetches on focus, so live updates simply never arrive.
# VITE_SOCKET_URL=https://notify-hub.onrender.com

# --- Browser push -------------------------------------------------------
# The VAPID *public* key, from the same Firebase project as the backend's
# FCM_* credentials: Firebase console -> Project settings -> Cloud Messaging ->
# Web Push certificate.
#
# Empty means the push page says so and keeps the button disabled, rather than
# failing at subscribe time. A key that does not match the one FCM signs with
# fails the same way - subscriptions are rejected with a 403 and nothing is
# delivered - so this has to be the public half of the matching pair.
#
# Public by design: this value ships to every browser. That is correct and safe.
VITE_VAPID_PUBLIC_KEY=

# The Firebase *web app* config, from the same project: Firebase console ->
# Project settings -> General -> Your apps -> Web app -> SDK setup and config.
# The page uses it to turn this browser into an FCM registration token, which is
# what the backend's FCM sender needs - a raw push subscription is rejected.
# All four are required; any missing means "Enable push" reports push is not
# configured. Public by design, like the VAPID key: the web config is not a secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Note: browser push also needs frontend/public/sw.js to be served. It is
# committed and copied into the build output by Vite. A deployment that serves
# the app from a subpath rather than the domain root will need the scope in
# src/push/register-service-worker.ts adjusted to match.