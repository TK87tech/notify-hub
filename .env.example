# Copy to .env and fill in. Never commit .env — it is in .gitignore.

# --- Core ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# --- Database (local Docker, or a free Neon connection string) ---
DATABASE_URL=postgresql://notifyhub:notifyhub@localhost:5432/notifyhub

# --- Redis for BullMQ (local Docker, or a free Upstash URL) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
SERVICE_KEY=change-me-too

# --- Email: Brevo free tier, 300/day ---
BREVO_API_KEY=
EMAIL_FROM="NotifyHub <no-reply@example.com>"

# --- Push: Firebase Cloud Messaging ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Frontend (goes in frontend/.env) ---
# VITE_API_URL=http://localhost:4000
# Point at the mock server instead while the backend is being built:
# VITE_API_URL=http://localhost:4010
